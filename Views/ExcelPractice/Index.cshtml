@model ExcelPracticeViewModel
@{
    ViewData["Title"] = "Excel Practice";
}

<h1>Excel Practice</h1>

<form method="get" asp-action="Index" class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label asp-for="Filter.Search" class="form-label">Search</label>
        <input asp-for="Filter.Search" class="form-control" placeholder="Salesperson, product, region" />
    </div>
    <div class="col-md-2">
        <label asp-for="Filter.Region" class="form-label">Region</label>
        <select asp-for="Filter.Region" asp-items="@(new SelectList(Model.Regions))" class="form-select">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="Filter.Product" class="form-label">Product</label>
        <select asp-for="Filter.Product" asp-items="@(new SelectList(Model.Products))" class="form-select">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="Filter.From" class="form-label">From</label>
        <input asp-for="Filter.From" type="date" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="Filter.To" class="form-label">To</label>
        <input asp-for="Filter.To" type="date" class="form-control" />
    </div>
    <div class="col-md-1 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<h2 class="mt-5">Orders</h2>
<p class="text-muted">@Model.Orders.Count order(s)</p>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle text-nowrap">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(m => m.Orders[0].OrderId)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].OrderCode)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].CustomerId)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].OrderDate)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].Status)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].PaymentMethod)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].PaymentStatus)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Orders[0].Subtotal)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Orders[0].ShippingFee)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Orders[0].DiscountAmount)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Orders[0].TotalAmount)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].ReceiverName)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].ReceiverPhone)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].ShippingAddress)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].City)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].Note)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].DeliveredAt)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].CreatedAt)</th>
                <th>@Html.DisplayNameFor(m => m.Orders[0].UpdatedAt)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Orders.Count == 0)
            {
                <tr>
                    <td colspan="19" class="text-center text-muted py-4">No orders in the database.</td>
                </tr>
            }
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.OrderCode</td>
                    <td>@order.CustomerId</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@order.Status</td>
                    <td>@order.PaymentMethod</td>
                    <td>@order.PaymentStatus</td>
                    <td class="text-end">@order.Subtotal.ToString("N0")</td>
                    <td class="text-end">@order.ShippingFee.ToString("N0")</td>
                    <td class="text-end">@order.DiscountAmount.ToString("N0")</td>
                    <td class="text-end">@order.TotalAmount?.ToString("N0")</td>
                    <td>@order.ReceiverName</td>
                    <td>@order.ReceiverPhone</td>
                    <td>@order.ShippingAddress</td>
                    <td>@order.City</td>
                    <td>@order.Note</td>
                    <td>@order.DeliveredAt?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@order.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
